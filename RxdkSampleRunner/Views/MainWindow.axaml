<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:RxdkSampleRunner.ViewModels"
        x:Class="RxdkSampleRunner.Views.MainWindow"
        x:Name="Root"
        Width="1100" Height="720" MinWidth="820" MinHeight="520"
        Icon="/Assets/app.ico"
        Title="RXDK Sample Runner — xemu / hardware test harness">

  <Grid RowDefinitions="Auto,Auto,*" Margin="10">

    <!-- Settings -->
    <Border Grid.Row="0" Background="#22FFFFFF" CornerRadius="6" Padding="10" Margin="0,0,0,8">
      <Grid ColumnDefinitions="Auto,*,Auto,Auto" RowDefinitions="Auto,Auto,Auto">
        <TextBlock Grid.Row="0" Grid.Column="0" Text="xemu path" VerticalAlignment="Center" Margin="0,0,10,4"/>
        <TextBox   Grid.Row="0" Grid.Column="1" Text="{Binding XemuPath}" Watermark="path to xemu.exe" Margin="0,0,6,4"/>
        <Button    Grid.Row="0" Grid.Column="2" Content="Browse…" Command="{Binding BrowseXemuCommand}" Margin="0,0,10,4"/>
        <StackPanel Grid.Row="0" Grid.Column="3" Orientation="Horizontal">
          <TextBlock Text="config" VerticalAlignment="Center" Margin="0,0,6,4"/>
          <ComboBox SelectedItem="{Binding Configuration, Mode=TwoWay}" Width="130" Margin="0,0,0,4">
            <x:String>Debug</x:String>
            <x:String>Release</x:String>
          </ComboBox>
        </StackPanel>

        <TextBlock Grid.Row="1" Grid.Column="0" Text="xemu params" VerticalAlignment="Center" Margin="0,0,10,4"/>
        <TextBox   Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" Text="{Binding XemuParams}"
                   Watermark="-device lpc47m157 -serial stdio" Margin="0,0,0,4"/>

        <TextBlock Grid.Row="2" Grid.Column="0" Text="samples root" VerticalAlignment="Center" Margin="0,0,10,0"/>
        <TextBox   Grid.Row="2" Grid.Column="1" Text="{Binding SamplesRoot}" Watermark="folder containing sample .vcxproj files" Margin="0,0,6,0"/>
        <Button    Grid.Row="2" Grid.Column="2" Content="Browse…" Command="{Binding BrowseSamplesCommand}" Margin="0,0,10,0"/>
        <StackPanel Grid.Row="2" Grid.Column="3" Orientation="Horizontal">
          <TextBlock Text="Xbox IP" VerticalAlignment="Center" Margin="0,0,6,0"/>
          <TextBox Text="{Binding ConsoleIp}" Watermark="devkit (optional)" Width="130"/>
        </StackPanel>
      </Grid>
    </Border>

    <!-- Toolbar -->
    <DockPanel Grid.Row="1" Margin="0,0,0,8">
      <Button Content="Refresh" Command="{Binding RefreshCommand}" Margin="0,0,6,0"/>
      <Button Content="Build All" Command="{Binding BuildAllCommand}" Margin="0,0,6,0"/>
      <Button Content="Cancel" Command="{Binding CancelCommand}" Margin="0,0,6,0"/>
      <Button Content="Screenshot → Clipboard" Command="{Binding ScreenshotCommand}" Margin="0,0,12,0"
              ToolTip.Tip="Grab the devkit's screen over xbdm and copy it to the clipboard"/>
      <Button DockPanel.Dock="Right" Content="Copy Log" Click="CopyLog_Click" Margin="6,0,0,0"/>
      <CheckBox DockPanel.Dock="Right" Content="Capture card" IsChecked="{Binding CaptureEnabled}"
                VerticalAlignment="Center" Margin="12,0,0,0"
                ToolTip.Tip="Show a live preview from a capture card (auto-selects Elgato)"/>
      <ComboBox DockPanel.Dock="Right" ItemsSource="{Binding CaptureDeviceList}"
                SelectedItem="{Binding SelectedCaptureDevice}" IsVisible="{Binding CaptureEnabled}"
                MinWidth="180" Margin="6,0,0,0" ToolTip.Tip="Capture device"/>
      <TextBlock Text="{Binding Status}" VerticalAlignment="Center" Foreground="#CCCCCC"/>
    </DockPanel>

    <!-- Samples | console -->
    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions>
        <!-- MinWidth keeps the splitter from shrinking the list below its text + buttons. -->
        <ColumnDefinition Width="420" MinWidth="360"/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*" MinWidth="200"/>
      </Grid.ColumnDefinitions>
      <Border Grid.Column="0" BorderBrush="#33FFFFFF" BorderThickness="1" CornerRadius="6">
        <ListBox ItemsSource="{Binding Samples}" Background="Transparent">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Grid ColumnDefinitions="*,Auto" Margin="2">
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                  <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="{Binding Category}" Foreground="#888888" FontSize="11"/>
                    <TextBlock Text="{Binding IsoStatusText}" FontSize="11"
                               Foreground="{Binding IsoExists, Converter={x:Static vm:BoolBrush.GreenGray}}"/>
                  </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                  <Button Content="Build" Padding="8,3"
                          Command="{Binding #Root.DataContext.BuildCommand}" CommandParameter="{Binding}"/>
                  <Button Content="xemu" Padding="8,3"
                          Command="{Binding #Root.DataContext.LaunchCommand}" CommandParameter="{Binding}"/>
                  <Button Content="HW" Padding="8,3" ToolTip.Tip="Deploy + run on the devkit"
                          Command="{Binding #Root.DataContext.DeployRunCommand}" CommandParameter="{Binding}"/>
                </StackPanel>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Border>

      <GridSplitter Grid.Column="1" Width="6" Background="Transparent"/>

      <Grid Grid.Column="2">
        <Grid.RowDefinitions>
          <RowDefinition Height="{Binding CaptureRowHeight}"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="3*"/>
        </Grid.RowDefinitions>

        <!-- Capture-card preview (top) -->
        <Border Grid.Row="0" IsVisible="{Binding CaptureEnabled}"
                BorderBrush="#33FFFFFF" BorderThickness="1" CornerRadius="6" Background="Black">
          <Grid>
            <Image Source="{Binding CaptureFrame}" Stretch="Uniform"/>
            <TextBlock Text="{Binding CaptureStatus}" Foreground="#AAFFFFFF" FontSize="11"
                       Margin="6" VerticalAlignment="Top" HorizontalAlignment="Left"/>
          </Grid>
        </Border>

        <GridSplitter Grid.Row="1" Height="6" HorizontalAlignment="Stretch"
                      Background="Transparent" IsVisible="{Binding CaptureEnabled}"/>

        <!-- Build / run log (bottom) -->
        <Border Grid.Row="2" BorderBrush="#33FFFFFF" BorderThickness="1" CornerRadius="6" Background="#101014">
          <ScrollViewer x:Name="LogScroll" Padding="8"
                        HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
            <SelectableTextBlock Text="{Binding Log}" FontFamily="Cascadia Mono,Consolas,monospace"
                                 FontSize="12" Foreground="#D0D0D0" TextWrapping="NoWrap"/>
          </ScrollViewer>
        </Border>
      </Grid>
    </Grid>
  </Grid>
</Window>
