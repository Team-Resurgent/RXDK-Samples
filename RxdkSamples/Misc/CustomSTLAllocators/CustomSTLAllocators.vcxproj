  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <PropertyGroup>
    <NMakeOutput>$(MSBuildProjectDirectory)\$(RxdkOutDir)\$(MSBuildProjectName).xbe</NMakeOutput>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|Xbox'">
    <RxdkBuildFlavor>Debug</RxdkBuildFlavor>
    <!-- This sample exercises the C++98 allocator interface (rebind, pointer,
         address, two-argument allocate), which libc++ gates on the standard with
         no opt-in macro. Build it as the C++ it was written for. -->
    <RxdkCppStandard>c++17</RxdkCppStandard>
    <!-- Its allocators report exhaustion by throwing std::bad_alloc. -->
    <RxdkExceptions>true</RxdkExceptions>
    <RxdkStackSize>65536</RxdkStackSize>
    <RxdkImageDebug>true</RxdkImageDebug>
    <RxdkDontMountUtilityDrive>true</RxdkDontMountUtilityDrive>
    <RxdkNoLibWarn>true</RxdkNoLibWarn>
    <RxdkTestId>0xffff0119</RxdkTestId>
    <RxdkTestName>CustomSTLAllocators</RxdkTestName>
    <RxdkTestVersion>4096</RxdkTestVersion>
    <RxdkTitleImage>..\..\Common\rxdk-titleimage.xbx</RxdkTitleImage>
    <RxdkDefaultSaveImage>..\..\Common\rxdk-saveimage.xbx</RxdkDefaultSaveImage>
  </PropertyGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)|$(Platform)'=='Debug|Xbox'">
    <ClCompile>
      <PreprocessorDefinitions>_USE_XGMATH;XBOX_SAMPLE;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <AdditionalIncludeDirectories>..\..\Common\Include;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
    </ClCompile>
    <Link>
      <AdditionalDependencies>libxbdmd.lib;libxapid.lib;libd3d8d.lib;libd3dx8d.lib;libxgraphicsd.lib;libdsoundd.lib;libkerneld.lib;libcd.lib;libcppd.lib;libcompatd.lib</AdditionalDependencies>
    </Link>
  </ItemDefinitionGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|Xbox'">
    <RxdkBuildFlavor>Release</RxdkBuildFlavor>
    <RxdkReleaseOptimize>ReleaseFast</RxdkReleaseOptimize>
    <!-- This sample exercises the C++98 allocator interface (rebind, pointer,
         address, two-argument allocate), which libc++ gates on the standard with
         no opt-in macro. Build it as the C++ it was written for. -->
    <RxdkCppStandard>c++17</RxdkCppStandard>
    <!-- Its allocators report exhaustion by throwing std::bad_alloc. -->
    <RxdkExceptions>true</RxdkExceptions>
    <RxdkStackSize>65536</RxdkStackSize>
    <RxdkImageDebug>true</RxdkImageDebug>
    <RxdkDontMountUtilityDrive>true</RxdkDontMountUtilityDrive>
    <RxdkTestId>0xffff0119</RxdkTestId>
    <RxdkTestName>CustomSTLAllocators</RxdkTestName>
    <RxdkTestVersion>4096</RxdkTestVersion>
    <RxdkTitleImage>..\..\Common\rxdk-titleimage.xbx</RxdkTitleImage>
    <RxdkDefaultSaveImage>..\..\Common\rxdk-saveimage.xbx</RxdkDefaultSaveImage>
  </PropertyGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)|$(Platform)'=='Release|Xbox'">
    <ClCompile>
      <PreprocessorDefinitions>_USE_XGMATH;XBOX_SAMPLE;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <AdditionalIncludeDirectories>..\..\Common\Include;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
    </ClCompile>
    <Link>
      <AdditionalDependencies>libxapi.lib;libd3d8.lib;libd3dx8.lib;libxgraphics.lib;libdsound.lib;libkernel.lib;libc.lib;libcpp.lib;libcompat.lib</AdditionalDependencies>
    </Link>
  </ItemDefinitionGroup>
  <ItemGroup>
